# Secrets and environments — .env holds API keys and must never be committed
.env
.venv/
venv/

# Python build and runtime artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches and state
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
__marimo__/
.studio/
.claude/worktrees/
.claude/scheduled_tasks.lock

# arXiv tree build artifacts (main.bbl IS tracked — arXiv needs it)
arxiv/main.pdf
arxiv/*.aux
arxiv/*.log
arxiv/*.out
arxiv/*.blg
arxiv/*.synctex.gz
arxiv/mainNotes.bib

# OS noise
.DS_Store

# Runtime output of homi benchmark (users' own runs; the frozen baseline
# aggregates live at data/chatbots/aggregates/)
benchmark_results/

# Local training telemetry and checkpoints
rl/track_a/runs/
.contract-algos/
rl/contract_algos/runs/*
!rl/contract_algos/runs/split-seed17.json

# Generated Hugging Face package
release/huggingface/generated/

