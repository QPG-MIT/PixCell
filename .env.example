# PixCell / HOMI environment variables
# Copy to .env and fill in what you need. The core loop — recreation, verifier,
# gate, workbench, studio light table — runs with NO key at all.

# Required for `homi extract` only: the single surviving API call in perception
# (B&W raster standardization of the chosen figure panel).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — chatbot-era baseline (--baseline) and `homi benchmark` model families.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional — tier-1/tier-2 FDTD physics (`homi simulate`, conductor MEASURE loop).
# Tier-0 mode solves are free and local; cloud spend is always human-gated.
TIDY3D_API_KEY=

# Optional — RL training study only (rl/train_pixcell.py, rl/train_sft.py).
TINKER_API_KEY=
WANDB_API_KEY=
